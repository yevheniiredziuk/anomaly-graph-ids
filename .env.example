# Copy to .env and adjust values for your environment
# .env is git-ignored

# --- Neo4j ---
NEO4J_AUTH=neo4j/changeme-local-only
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Memory tuning — adjust based on available RAM
# For 16+ GB RAM laptops: leave defaults (2G heap, 1G pagecache)
# For 8 GB RAM laptops: set HEAP=1G PAGECACHE=512M
NEO4J_HEAP=2G
NEO4J_PAGECACHE=1G

# --- PostgreSQL ---
POSTGRES_DB=ids
POSTGRES_USER=ids
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_PORT=5432
